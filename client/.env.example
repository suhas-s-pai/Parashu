# Copy to client/.env and fill in. Vite only exposes variables prefixed with
# VITE_, and everything exposed to the browser is public — never put the
# Supabase service role key here.

# Supabase → Project Settings → Data API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → anon / public
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Defaults to the deployed backend when unset; point it at
# http://localhost:5000 to develop against the local Express server.
# VITE_API_BASE=http://localhost:5000
