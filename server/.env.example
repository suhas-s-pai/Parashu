# Supabase — Project Settings → Data API (URL) and API Keys
SUPABASE_URL=https://your-project-ref.supabase.co

# Preferred for the backend: bypasses Row Level Security.
# Server-side only — never expose this key to the React client or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional fallback, only used if the service role key is absent.
# With RLS enabled on sos_alerts, every query made with this key will fail.
# SUPABASE_ANON_KEY=your-anon-key

# Comma separated list of origins allowed to call this API.
# Leave unset to allow any origin.
# CORS_ORIGIN=https://your-app.vercel.app,http://localhost:5173

# Render injects PORT automatically. Falls back to 5000 locally.
# PORT=5000
