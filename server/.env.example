# Template only — never put a real value in this file. It is committed to git.
# Copy it to server/.env (which is ignored) and fill that in instead.

# Supabase → Project Settings → Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Secret keys (sb_secret_…), or the
# legacy service_role key. Bypasses Row Level Security.
# Server-side only — never expose this to the React client and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Optional fallback, only used if the secret key is absent.
# With RLS enabled on sos_alerts, every query made with this key will fail.
# SUPABASE_ANON_KEY=your-publishable-key

# Comma separated list of origins allowed to call this API.
# Leave unset to allow any origin.
# CORS_ORIGIN=https://your-app.vercel.app,http://localhost:5173

# Render injects PORT automatically. Falls back to 5000 locally.
# PORT=5000
